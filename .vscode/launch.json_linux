{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug project (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/obd_raspi_cpp",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build project (Makefile)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}

